# Google Gen AI / Gemma API Key (Leave empty to run in test/offline mode)
GEMMA_API_KEY=

# Gemma model to use
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional GitHub Token to increase GitHub API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Allowed Frontend Origins (comma-separated or single)
FRONTEND_ORIGIN=http://localhost:3000

# Server settings
HOST=127.0.0.1
PORT=8000
